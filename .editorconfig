# EditorConfig is awesome: https://editorconfig.org

# Top-most EditorConfig file
root = true

# Unix-style newlines with a space at the end of the line
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8

# 4 space indentation
[*.js]
indent_style = space
indent_size = 2

# 2 space indentation
[*{.json,yaml,yml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
